diff --git a/binder/Makefile b/binder/Makefile
index ee0d72b..41fe082 100644
--- a/binder/Makefile
+++ b/binder/Makefile
@@ -2,6 +2,12 @@ ccflags-y += -I$(src) -Wno-int-conversion -DCONFIG_ANDROID_BINDER_DEVICES="\"bin
 obj-m := binder_linux.o
 binder_linux-y := deps.o binder.o binder_alloc.o binderfs.o
 
+# Newer kernels replaced zap_page_range_single() with zap_vma_range(vma, addr, size).
+# Detect by header, not by version: the exact version of the rename is not pinned.
+ifneq ($(shell grep -sw 'void zap_vma_range' $(srctree)/include/linux/mm.h),)
+ccflags-y += -DBINDER_HAVE_ZAP_VMA_RANGE
+endif
+
 KERNEL_SRC ?= /lib/modules/$(shell uname -r)/build
 
 all:
